# Copia este fichero a `.env`. El `.env` no se versiona nunca.
#
# Aqui van SECRETOS y ajustes de tu maquina. Los valores por defecto del
# sistema viven en `config/defaults.toml`, que si se versiona y lleva cada
# opcion explicada. Cualquier variable de las de alli puesta aqui gana al
# fichero, asi que esto sirve tambien para probar algo puntual sin tocar
# la configuracion del proyecto.

# =========================================================================
# Credenciales
# =========================================================================

# --- Opcion A: Bedrock (el proveedor por defecto) ------------------------
# Las credenciales salen de la cadena estandar de AWS. Si te autenticas con
# perfil, SSO o rol de instancia, deja estas dos lineas COMENTADAS:
# definirlas aqui gana a esa cadena y el fallo sale como un error de firma
# que no explica nada.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# --- Opcion B: API de primera parte --------------------------------------
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...

# =========================================================================
# Ajustes de tu maquina
# =========================================================================

# Si el 8000 esta ocupado, mueve los dos extremos a la vez: la UI habla con
# la API por HTTP.
# MTG_API_URL=http://127.0.0.1:8000

# Probar otro modelo sin tocar config/defaults.toml. Ojo: la politica IAM de
# la cuenta enumera que modelos y regiones se permiten.
# MTG_MODEL=

# El resto de opciones (max_tokens, effort, top_k, paginacion de la API de
# cartas...) estan en config/defaults.toml con su porque al lado. El nombre
# en MAYUSCULAS que aparece en cada comentario de ese fichero es la variable
# que la pisa desde aqui.
